# Copie ce fichier en .env (ignoré par git) et remplis les vraies valeurs.
# Avant de lancer main.py ou l'API :  export $(grep -v '^#' .env | xargs)
LUMISAFE_MQTT_PASSWORD=CHANGE_ME_MOT_DE_PASSE_FORT

# Clé donnée à François pour authentifier son dashboard (header X-API-Key).
# Génère-la avec :  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LUMISAFE_API_KEY=CHANGE_ME_CLE_API

